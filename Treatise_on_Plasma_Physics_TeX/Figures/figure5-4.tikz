\begin{tikzpicture}
    \begin{axis}[
        width=0.95\linewidth,
        colormap={blackwhite}{gray(0cm)=(0); gray(1cm)=(0)},
        xmin=0.001, xmax=2,
        ymin=-0.25, ymax=4,
        axis background/.style={fill=white},
        xlabel={$r/r_0$},
        ylabel={$z/r_0$},
        xlabel near ticks,
        ylabel near ticks,
        ylabel style={rotate=-90, anchor=east},
        unbounded coords=jump,
        restrict x to domain=0:2.5
    ]
        % Equation converted to a polar parameterization! 
        % The parameter 't' sweeps 360 degrees, smoothly tracing the full kidney loops without any cuts.
        \pgfplotsinvokeforeach{-0.24, -0.2, -0.15, -0.1, -0.05, 0.02, 0.1}{
            \addplot[ultra thick, black, samples=721, domain=0:360, variable=t] 
                ( {exp(sqrt(max(0, 2*(#1) + 0.5)) * cos(t))}, 
                  {1 + sqrt(max(0, 4*(#1) + 1))*sin(t) >= 0 ? sqrt(1 + sqrt(max(0, 4*(#1) + 1))*sin(t)) : nan} );
            
            \addplot[ultra thick, black, samples=721, domain=0:360, variable=t] 
                ( {exp(sqrt(max(0, 2*(#1) + 0.5)) * cos(t))}, 
                  {1 + sqrt(max(0, 4*(#1) + 1))*sin(t) >= 0 ? -sqrt(1 + sqrt(max(0, 4*(#1) + 1))*sin(t)) : nan} );
        }
        
        % The c=0 (red) contour explicitly drawn
        \addplot[ultra thick, red, samples=721, domain=0:360, variable=t] 
            ( {exp(sqrt(0.5) * cos(t))}, 
              {1 + sin(t) >= 0 ? sqrt(1 + sin(t)) : nan} );
        
        \addplot[ultra thick, red, samples=721, domain=0:360, variable=t] 
            ( {exp(sqrt(0.5) * cos(t))}, 
              {1 + sin(t) >= 0 ? -sqrt(1 + sin(t)) : nan} );

        \fill[red] (axis cs:1,0) circle (1.5pt);
    \end{axis}
\end{tikzpicture}
